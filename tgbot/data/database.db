def create_bdx():
    import sqlite3
    from tgbot.config import PATH_DATABASE
    
    with sqlite3.connect(PATH_DATABASE) as con:
        # Таблица пользователей
        con.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                user_name TEXT,
                first_name TEXT,
                last_name TEXT,
                lang TEXT DEFAULT 'ru',
                ballance REAL DEFAULT 0,
                ban INTEGER DEFAULT 0,
                feed_back TEXT DEFAULT 'active'
            )
        ''')
        
        # Таблица цен
        con.execute('''
            CREATE TABLE IF NOT EXISTS price (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name_full REAL DEFAULT 100,
                name_standart REAL DEFAULT 50,
                phone REAL DEFAULT 30,
                inn REAL DEFAULT 40,
                email REAL DEFAULT 25,
                inn_fl REAL DEFAULT 35,
                passport REAL DEFAULT 45,
                snils REAL DEFAULT 55,
                avto REAL DEFAULT 60,
                vin REAL DEFAULT 70,
                scoring REAL DEFAULT 80,
                credit REAL DEFAULT 90
            )
        ''')
        
        # Таблица запросов
        con.execute('''
            CREATE TABLE IF NOT EXISTS requests (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                type_request TEXT,
                data TEXT,
                answer TEXT,
                date TEXT
            )
        ''')
        
        # Таблица платежей
        con.execute('''
            CREATE TABLE IF NOT EXISTS payments (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                amount REAL,
                status TEXT,
                date TEXT
            )
        ''')
        
        # Таблица FAQ
        con.execute('''
            CREATE TABLE IF NOT EXISTS faq (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name_button TEXT,
                name_button_en TEXT,
                description TEXT,
                description_en TEXT,
                is_show INTEGER DEFAULT 1
            )
        ''')
        
        con.commit()
